    <RecipeDef>
        <defName>Make_HEWarhead</defName>
        <label>craft HE warhead</label>
        <workAmount>500</workAmount>
        <skillRequirements>
            <Crafting>6</Crafting>
        </skillRequirements>
        <ingredients>
            <li><thingDef>Chemfuel</thingDef><count>25</count></li>
            <li><thingDef>Steel</thingDef><count>15</count></li>
        </ingredients>
        <products>
            <li><thingDef>HEWarhead</thingDef><count>1</count></li>
        </products>
        <recipeUsers>
            <li>MissileAssemblyBench</li>
        </recipeUsers>
    </RecipeDef>

