<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!-- TOMAHAWK PROJECTILES -->
    <ThingDef ParentName="BaseProjectile">
        <defName>Projectile_Tomahawk_HE</defName>
        <label>tomahawk explosive strike</label>
        <projectile>
            <damageDef>Bomb</damageDef>
            <damageAmountBase>100</damageAmountBase>
            <explosionRadius>6.5</explosionRadius>
            <explosionSound>Explosion_Bomb</explosionSound>
            <preExplosionSpawnThingDef>ExplosionFlash</preExplosionSpawnThingDef>
            <explosionChanceToStartFire>0.25</explosionChanceToStartFire>
        </projectile>
        <graphicData>
            <texPath>Things/Projectile/TomahawkHE</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
    </ThingDef>

    <ThingDef ParentName="BaseProjectile">
        <defName>Projectile_Tomahawk_EMP</defName>
        <label>tomahawk EMP blast</label>
        <projectile>
            <damageDef>EMP</damageDef>
            <damageAmountBase>50</damageAmountBase>
            <explosionRadius>6.0</explosionRadius>
            <explosionSound>Explosion_EMP</explosionSound>
            <preExplosionSpawnThingDef>ExplosionFlash</preExplosionSpawnThingDef>
        </projectile>
        <graphicData>
            <texPath>Things/Projectile/TomahawkEMP</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
    </ThingDef>

    <ThingDef ParentName="BaseProjectile">
        <defName>Projectile_Tomahawk_Incendiary</defName>
        <label>tomahawk incendiary blast</label>
        <projectile>
            <damageDef>Flame</damageDef>
            <damageAmountBase>20</damageAmountBase>
            <explosionRadius>5.0</explosionRadius>
            <explosionChanceToStartFire>1.0</explosionChanceToStartFire>
            <explosionSound>Explosion_Flame</explosionSound>
            <preExplosionSpawnThingDef>ExplosionFlash</preExplosionSpawnThingDef>
        </projectile>
        <graphicData>
            <texPath>Things/Projectile/TomahawkIncendiary</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
    </ThingDef>

    <!-- IN-FLIGHT TOMAHAWK -->
    <Projectile_Explosive>
        <defName>Tomahawk_Incoming</defName>
        <label>in-flight Tomahawk</label>
        <graphicData>
            <texPath>Things/Weapons/TomahawkMissile_Base</texPath>
            <drawSize>(1,1)</drawSize>
        </graphicData>
        <speed>30</speed>
        <damageAmount>200</damageAmount>
        <damageDef>Bomb</damageDef>
        <explosionRadius>5</explosionRadius>
        <postExplosionSpawnThingDef>Filth_Smoke</postExplosionSpawnThingDef>
        <postExplosionSpawnChance>1.0</postExplosionSpawnChance>
    </Projectile_Explosive>

</Defs>
