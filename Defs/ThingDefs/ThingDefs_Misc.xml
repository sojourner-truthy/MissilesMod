<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThingDef ParentName="BasedWarhead">
        <defName>HEWarhead</defName>
        <label>HE warhead</label>
        <description>A high-explosive warhead for Tomahawk missiles.</description>
        <graphicData>
            <texPath>Things/Resources/warhead</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(2,2)</drawSize>
        </graphicData>
        <statBases>
            <MarketValue>12000</MarketValue>
            <Mass>45</Mass>
        </statBases>
        <comps>
            <li Class="CompProperties_Explosive">
                <damageAmountBase>150</damageAmountBase>
                <explosiveRadius>3.5</explosiveRadius>
                <explosiveDamageType>Bomb</explosiveDamageType>
                <explosiveExpandPerStackcount>0.5</explosiveExpandPerStackcount>
                <startWickOnDamageTaken>
                    <li>Bomb</li>
                </startWickOnDamageTaken>
                <startWickHitPointsPercent>0.5</startWickHitPointsPercent>
                <preExplosionSpawnThingDef>Filth_Soot</preExplosionSpawnThingDef>
                <preExplosionSpawnChance>1.0</preExplosionSpawnChance>
                <applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
                <explodeOnKilled>True</explodeOnKilled>
                <wickTicks>60~90</wickTicks>
            </li>
        </comps>
        <recipeMaker>
            <productCount>1</productCount>
            <workAmount>30000</workAmount>
            <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
            <workSkill>Crafting</workSkill>
            <effectWorking>ConstructMetal</effectWorking>
            <soundWorking>Recipe_Machining</soundWorking>
            <recipeUsers>
                <li>TableRimatomicsMachining</li>
            </recipeUsers>
            <unfinishedThingDef>UnfinishedRimatomics</unfinishedThingDef>
            <costList>
                <Steel>60</Steel>
                <ComponentIndustrial>3</ComponentIndustrial>
                <Plutonium>2</Plutonium>
            </costList>
        </recipeMaker>
    </ThingDef>

