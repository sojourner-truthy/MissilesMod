<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThingDef ParentName="BasedRimatomicsMom" Class="Rimatomics.LaunchPad">
        <defName>TomahawkLaunchPad</defName>
        <label>Tomahawk launch pad</label>
        <description>
            A compact, ruggedized launch pad for firing a single Tomahawk missile straight up.
            Integrates power, diagnostics, and safety interlocks.
        </description>
        <graphicData>
            <texPath>Things/Buildings/Launchers/TomahawkLaunchPad_Base</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(1,1)</drawSize>
            <allowFlip>false</allowFlip>
        </graphicData>
        <category>Building</category>
        <designationCategory>Rimatomics</designationCategory>
        <passability>Standable</passability>
        <size>(1,1)</size>
        <rotatable>true</rotatable>
        <blockWind>false</blockWind>
        <staticSunShadowHeight>0.2</staticSunShadowHeight>
        <drawOffscreen>true</drawOffscreen>
        <fillPercent>0.2</fillPercent>
        <altitudeLayer>Building</altitudeLayer>
        <surfaceType>Item</surfaceType>
        <tickerType>Normal</tickerType>
        <stuffCategories>
            <li>Metallic</li>
        </stuffCategories>
        <costStuffCount>200</costStuffCount>
        <costList>
            <Steel>150</Steel>
            <ComponentIndustrial>10</ComponentIndustrial>
            <ComponentSpacer>1</ComponentSpacer>
        </costList>
        <statBases>
            <MaxHitPoints>1200</MaxHitPoints>
            <WorkToBuild>20000</WorkToBuild>
        </statBases>
        <comps>
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <basePowerConsumption>500</basePowerConsumption>
                <shortCircuitInRain>true</shortCircuitInRain>
            </li>
            <li Class="CompProperties_Flickable"/>
            <li Class="CompProperties_Breakdownable"/>
            <li Class="CompProperties_Glower">
                <glowRadius>3</glowRadius>
                <glowColor>(0.2,0.8,0.2,0.6)</glowColor>
            </li>
            <li Class="CompProperties_AffectedByFacilities">
                <linkableFacilities>
                    <li>ToolCabinet</li>
                </linkableFacilities>
            </li>
            <li Class="CompProperties_ChangeableProjectile">
                <ammoFilter>
                    <li>TomahawkMissile_HE</li>
                    <li>TomahawkMissile_EMP</li>
                    <li>TomahawkMissile_Incendiary</li>
                </ammoFilter>
                <ammoCount>1</ammoCount>
                <shellTexPath>Things/Buildings/Launchers/TomahawkLaunchPad_Loaded</shellTexPath>
                <drawWithProjectile>true</drawWithProjectile>
            </li>
            <li Class="CompProperties_Launchable">
                <projectileDef>Tomahawk_Incoming</projectileDef>
                <launchDistance>0</launchDistance>
                <arcHeightFactor>100</arcHeightFactor>
                <requiresTarget>false</requiresTarget>
            </li>
        </comps>
        <placeWorkers>
            <li>PlaceWorker_NotUnderRoof</li>
            <li>PlaceWorker_ShowFacilitiesConnections</li>
        </placeWorkers>
        <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
        <interactionCellOffset>(0,0,-1)</interactionCellOffset>
        <inspectorTabs>
            <li>ITab_Bills</li>
        </inspectorTabs>
        <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
        <researchPrerequisites>
            <li>Research_MissileAssembly</li>
        </researchPrerequisites>
    </ThingDef>
</Defs>
